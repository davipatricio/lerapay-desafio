{
  "name": "@lerapay/monorepo",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26.7.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "2.10.10"
  },
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@types/node": "26.2.0",
      "oxfmt": "0.63.0",
      "oxlint": "1.78.0"
    },
    "catalogs": {
      "frontend": {
        "typescript": "7.0.2"
      },
      "backend": {
        "typescript": "6.0.3"
      }
    }
